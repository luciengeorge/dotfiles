{
  "[python]": {
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.tabSize": 4,
  },
  "editor.bracketPairColorization.enabled": true,
  "editor.detectIndentation": false,
  "editor.guides.bracketPairs": true,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.renderControlCharacters": true,
  "editor.showFoldingControls": "always",
  "editor.snippetSuggestions": "bottom",
  "editor.tabSize": 2,
  "emmet.includeLanguages": {
    "erb": "html",
    "*.erb": "html",
    "ruby": "html",
    "javascript": "javascriptreact",
    "typescript": "typescriptreact",
  },
  "emmet.showSuggestionsAsSnippets": true,
  "emmet.triggerExpansionOnTab": true,
  "explorer.confirmDelete": false,
  "editor.rulers": [],
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.egg-info": true,
    "**/.git": true,
    ".asset-cache": true,
    ".bundle": true,
    ".ipynb_checkpoints": true,
    ".pytest_cache": true,
    ".sass-cache": true,
    ".svn": true,
    "__pycache__": true,
    "_site": true,
    "build": true,
    "coverage": true,
    "dist": true,
    "out": true,
    "log": true,
    "node_modules": true,
    "public/packs": true,
    "tmp": true,
    ".yarn": true,
  },
  "files.hotExit": "off",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    "**/audits/**": true,
    "**/coverage/**": true,
    "**/log/**": true,
    "**/node_modules/**": true,
    "**/tmp/**": true,
    "**/vendor/**": true,
  },
  "python.terminal.activateEnvironment": false,
  "window.restoreWindows": "none",
  "workbench.iconTheme": "catppuccin-latte",
  "workbench.settings.editor": "json",
  "workbench.settings.openDefaultSettings": true,
  "workbench.settings.useSplitJSON": true,
  "editor.inlineSuggest.enabled": true,
  "workbench.colorTheme": "Night Owl Light (No Italics)",
  "editor.fontSize": 12,
  "editor.trimAutoWhitespace": true,
  "editor.useTabStops": true,
  "editor.formatOnPaste": true,
  "editor.scrollBeyondLastLine": false,
  "gitlens.advanced.messages": {
    "suppressGitDisabledWarning": true,
    "suppressGkRequestFailed500Warning": true,
  },
  "search.mode": "reuseEditor",
  "vsicons.dontShowNewVersionMessage": true,
  "files.associations": {
    "*.ejson": "json",
    "*.css": "tailwindcss",
  },
  "remote.SSH.defaultExtensions": [
    "eamodio.gitlens",
    "GitHub.copilot",
    "castwide.solargraph",
    "aliariff.auto-add-brackets",
    "aaron-bond.better-comments",
    "kaiwood.endwise",
  ],
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "scminput": false,
    "yaml": true,
  },
  "editor.accessibilitySupport": "on",
  "sorbet.enabled": true,
  "workbench.editor.wrapTabs": true,
  "explorer.openEditors.sortOrder": "alphabetical",
  "[ruby]": {
    "editor.defaultFormatter": "Shopify.ruby-lsp",
    "editor.formatOnSave": true,
    "editor.insertSpaces": true,
    "editor.formatOnType": true,
    "editor.semanticHighlighting.enabled": true,
    "editor.tabSize": 2,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "editor.rulers": [120],
  },
  "byesig.fold": false,
  "byesig.enabled": true,
  "byesig.opacity": 0.5,
  "byesig.showIcon": false,
  "editor.linkedEditing": true,
  "lldb.library": "/Applications/Xcode.app/Contents/SharedFrameworks/LLDB.framework/Versions/A/LLDB",
  "editor.stickyScroll.enabled": true,
  "security.workspace.trust.untrustedFiles": "open",
  "[liquid]": {
    "editor.defaultFormatter": "sissel.shopify-liquid",
    "editor.formatOnSave": false,
  },
  "git.openRepositoryInParentFolders": "never",
  "[javascript]": {
    // "editor.defaultFormatter": "biomejs.biome"
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "lldb.suppressUpdateNotifications": true,
  "editor.formatOnSave": true,
  "prettier.jsxSingleQuote": true,
  "prettier.singleQuote": true,
  "editor.wordWrap": "on",
  "rubyLsp.enabledFeatures": {
    "codeActions": true,
    "diagnostics": true,
    "documentHighlights": true,
    "documentLink": true,
    "documentSymbols": true,
    "foldingRanges": true,
    "formatting": true,
    "hover": true,
    "inlayHint": true,
    "onTypeFormatting": true,
    "selectionRanges": true,
    "semanticHighlighting": true,
    "completion": true,
    "codeLens": true,
  },
  "rubyLsp.rubyVersionManager": {
    "identifier": "auto",
  },
  // "editor.defaultFormatter": "biomejs.biome"
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "scm.autoReveal": false,
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma",
  },
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "explorer.confirmDragAndDrop": false,
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "workbench.editorAssociations": {
    "*.db": "sqlite-viewer.option",
  },
  "editor.fontFamily": "DankMono, Monaco, 'Courier New', monospace",
  "workbench.tree.enableStickyScroll": true,
  "search.exclude": {
    "**/*.rbi": true,
  },
  "git.autofetch": true,
  "prisma.enableCodeLens": true,
  "github.copilot.editor.enableAutoCompletions": true,
  "workbench.colorCustomizations": {
    "[Night Owl Light (No Italics)]": {
      "editorBracketMatch.border": "#10b981",
      "editorBracketMatch.background": "#10b981",
    },
  },
  // "editor.codeActionsOnSave": {
  //   "source.fixAll.eslint": "explicit",
  //   "source.fixAll.biome": "explicit",
  //   "source.organizeImports.biome": "explicit",
  // },
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
    "pubspec.yaml": "pubspec.lock,pubspec_overrides.yaml,.packages,.flutter-plugins,.flutter-plugins-dependencies,.metadata",
    "*.dart": "${capture}.g.dart",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*",
  },
  "workbench.preferredDarkColorTheme": "Night Owl (No Italics)",
  "workbench.preferredHighContrastColorTheme": "Night Owl (No Italics)",
  "workbench.preferredHighContrastLightColorTheme": "Night Owl Light (No Italics)",
  "workbench.preferredLightColorTheme": "Catppuccin Latte",
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "on",
    "strings": "on",
  },
  "tailwindCSS.emmetCompletions": true,
  "window.autoDetectColorScheme": true,
  "window.titleBarStyle": "custom",
  "terminal.integrated.minimumContrastRatio": 1,
  "typescript.referencesCodeLens.enabled": true,
  "gitlens.ai.model": "anthropic:claude-3-5-sonnet-latest",
  "editor.minimap.enabled": true,
  "githubPullRequests.pullBranch": "never",
  "cursor.cpp.enablePartialAccepts": true,
  "typescript.tsserver.log": "verbose",
  "cursor.cpp.disabledLanguages": ["markdown", "plaintext", "typescriptreact"],
  "editor.foldingImportsByDefault": false,
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true,
    },
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "cursor.composer.usageSummaryDisplay": "always",
  "typescript.tsserver.maxTsServerMemory": 4000,
  "catppuccin.italicComments": false,
  "catppuccin.italicKeywords": false,
  "python.defaultInterpreterPath": "/opt/homebrew/bin/python3.13",
  "security.promptForLocalFileProtocolHandling": false,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
  },
  "accessibility.signals.voiceRecordingStarted": {
    "sound": "off",
  },
  "update.mode": "silentlyApplyOnQuit",
  "accessibility.signals.lineHasBreakpoint": {
    "sound": "off",
    "announcement": "off",
  },
  "accessibility.signals.chatEditModifiedFile": {
    "sound": "off",
  },
  "accessibility.signals.chatRequestSent": {
    "sound": "off",
    "announcement": "off",
  },
  "accessibility.signals.chatResponseReceived": {
    "sound": "off",
  },
  "accessibility.signals.clear": {
    "sound": "off",
    "announcement": "off",
  },
  "accessibility.signals.codeActionApplied": {
    "sound": "off",
  },
  "accessibility.signals.codeActionTriggered": {
    "sound": "off",
    "announcement": "off",
  },
  "accessibility.signals.onDebugBreak": {
    "sound": "off",
    "announcement": "off",
  },
  "accessibility.signals.diffLineDeleted": {
    "sound": "off",
  },
  "accessibility.signals.diffLineInserted": {
    "sound": "off",
  },
  "accessibility.signals.diffLineModified": {
    "sound": "off",
  },
  "accessibility.signals.editsKept": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.positionHasError": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.lineHasError": {
    "sound": "off",
    "announcement": "off",
  },
  "accessibility.signals.lineHasFoldedArea": {
    "sound": "off",
    "announcement": "off",
  },
  "accessibility.signals.lineHasInlineSuggestion": {
    "sound": "off",
  },
  "accessibility.signals.noInlayHints": {
    "sound": "off",
    "announcement": "off",
  },
  "accessibility.signals.notebookCellCompleted": {
    "sound": "off",
    "announcement": "off",
  },
  "accessibility.signals.notebookCellFailed": {
    "sound": "off",
    "announcement": "off",
  },
  "accessibility.signals.progress": {
    "sound": "off",
    "announcement": "off",
  },
  "accessibility.signals.taskCompleted": {
    "sound": "off",
    "announcement": "off",
  },
  "accessibility.signals.taskFailed": {
    "sound": "off",
    "announcement": "off",
  },
  "accessibility.signals.terminalBell": {
    "sound": "off",
    "announcement": "off",
  },
  "accessibility.signals.terminalCommandFailed": {
    "sound": "off",
    "announcement": "off",
  },
  "accessibility.signals.terminalCommandSucceeded": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.terminalQuickFix": {
    "sound": "off",
    "announcement": "off",
  },
  "accessibility.signals.editsUndone": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.voiceRecordingStopped": {
    "sound": "off",
  },
  "accessibility.signals.positionHasWarning": {
    "sound": "off",
    "announcement": "auto",
  },
  "accessibility.signals.lineHasWarning": {
    "sound": "off",
    "announcement": "off",
  },
  "typescript.experimental.useTsgo": false,
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml",
  ],
}
