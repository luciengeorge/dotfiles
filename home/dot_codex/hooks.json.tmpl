{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.codex/hooks/plan-review.sh'",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.codex/hooks/vault-mark.sh'",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'{{ .chezmoi.homeDir }}/.codex/hooks/vault-stop.sh'",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
