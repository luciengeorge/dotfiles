export HOMEBREW_NO_ANALYTICS=1
export EDITOR=vim
export BUNDLER_EDITOR=code

_zcache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh
[[ -d $_zcache ]] || mkdir -p $_zcache

# Cache slow `eval "$(tool init)"` output; regenerated when the binary changes.
_cache_eval() {
  local f=$_zcache/$1.zsh bin=${commands[$2]:-$2}; shift 2
  [[ -x $bin ]] || return
  [[ -s $f && $f -nt $bin ]] || "$@" >| $f
  source $f
}

[[ -x /opt/homebrew/bin/brew ]] && _cache_eval brew /opt/homebrew/bin/brew /opt/homebrew/bin/brew shellenv

typeset -U path fpath
path=(
  ./bin ./node_modules/.bin
  $HOME/.local/bin
  $HOME/.bun/bin
  $HOME/.grok/bin
  $HOME/Library/pnpm
  $path
  $HOME/.lmstudio/bin
)
export PNPM_HOME=$HOME/Library/pnpm
export BUN_INSTALL=$HOME/.bun
export RUBY_CONFIGURE_OPTS="--with-openssl-dir=${HOMEBREW_PREFIX:-/opt/homebrew}/opt/openssl@3"

fpath=(
  $HOME/.grok/completions/zsh
  $HOME/.bun
  ${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-completions
  ${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh/site-functions
  $fpath
)

# oh-my-zsh: prompt comes from Warp; keep only the git aliases.
export ZSH=$HOME/.oh-my-zsh
ZSH_THEME=""
DISABLE_AUTO_UPDATE=true
DISABLE_UPDATE_PROMPT=true
ZSH_DISABLE_COMPFIX=true
plugins=(git gitfast)
[[ $TERM_PROGRAM == WarpTerminal ]] || plugins+=(history-substring-search)
source $ZSH/oh-my-zsh.sh

_cache_eval rbenv rbenv rbenv init - --no-rehash zsh
_cache_eval op op op completion zsh && compdef _op op
_cache_eval entire entire entire completion zsh

[[ -r $HOME/.vite-plus/env ]] && source $HOME/.vite-plus/env

for _gcloud in ${HOMEBREW_PREFIX:-/opt/homebrew}/share/google-cloud-sdk $HOME/google-cloud-sdk; do
  [[ -r $_gcloud/path.zsh.inc ]] || continue
  source $_gcloud/path.zsh.inc
  source $_gcloud/completion.zsh.inc
  break
done
unset _gcloud

if [[ -d ${HOMEBREW_PREFIX:-/opt/homebrew}/opt/fzf ]]; then
  source ${HOMEBREW_PREFIX:-/opt/homebrew}/opt/fzf/shell/completion.zsh
  source ${HOMEBREW_PREFIX:-/opt/homebrew}/opt/fzf/shell/key-bindings.zsh
fi

# Warp has its own input editor, so ZLE plugins only load in other terminals.
if [[ $TERM_PROGRAM != WarpTerminal ]]; then
  source ${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-autosuggestions/zsh-autosuggestions.zsh 2>/dev/null
  source ${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh 2>/dev/null
  typeset -A ZSH_HIGHLIGHT_STYLES
  ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=220'
  ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=220'
  ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=196'
  for _s in command builtin alias function precommand commandseparator hashed-command; do
    ZSH_HIGHLIGHT_STYLES[$_s]='fg=#00a63e'
  done
  unset _s
fi

[[ -r $HOME/.config/zsh/aliases.zsh ]] && source $HOME/.config/zsh/aliases.zsh
[[ -r $HOME/.config/zsh/secrets.zsh ]] && source $HOME/.config/zsh/secrets.zsh
[[ -r $HOME/.config/zsh/local.zsh ]] && source $HOME/.config/zsh/local.zsh
